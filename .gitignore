# Godot 4 editor/import cache (regenerated by `make import`)
.godot/
# Android Gradle build template (reinstalled by `make android-template`)
/android/
# Build outputs, captures, test reports (.gdignore keeps Godot from importing them)
builds/*
!builds/.gdignore
*.apk
*.aab
*.ipa
*.xcarchive

# Signing and export secrets — must never be committed
# Per-clone Claude Code settings
.claude/settings.local.json
export_credentials.cfg
*.keystore
*.jks
*.p12
*.mobileprovision
*.env
.env*

# Temporary project-setting override written by tools/capture.sh
override.cfg

# Misc
*.tmp
.DS_Store
mono_crash.*.json
